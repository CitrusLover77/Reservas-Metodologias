# Copiá este archivo a .env y completá con tus valores reales.
# .env NO se commitea (ver .gitignore).

APP_ENV=local
APP_DEBUG=true

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=citruszone
DB_USER=citruszone
DB_PASS=changeme

# La v7 de firebase/php-jwt exige un secreto largo (mínimo ~32 caracteres para HS256).
# Generá el tuyo con: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=8f2b6a1e4c9d7f30b5a8e6c1d4f9a2b7e0c3d6f9a1b4e7c0d3f6a9b2e5c8d1f4
JWT_TTL_SECONDS=86400

CORS_ALLOWED_ORIGIN=http://localhost:5500
